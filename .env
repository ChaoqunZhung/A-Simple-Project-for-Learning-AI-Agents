# Copy to .env. Credentials are read only from the process environment / .env.
OPENAI_BASE_URL=xxx
OPENAI_API_KEY=xxx
# Use a model offered by your provider that supports Chat Completions tools.
OPENAI_MODEL=gpt-5.5
TAVILY_API_KEY=

# Optional settings 
MAX_TOOL_LOOPS=8
MEMORY_TURNS=10
MAX_SESSIONS=1000
LLM_TIMEOUT_SECONDS=60
PYTHON_TIMEOUT_SECONDS=30
LOG_LEVEL=DEBUG
